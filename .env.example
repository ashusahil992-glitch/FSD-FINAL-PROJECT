# Backend (set these as environment variables before `mvn spring-boot:run`)
DB_URL=jdbc:mysql://127.0.0.1:3306/campusbazaar?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=campusbazaar_app
DB_PASSWORD=your_strong_password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:5173
ADMIN_EMAIL=admin@campusbazaar.demo
ADMIN_PASSWORD=ChangeMe@123
SEED_ENABLED=true
# Optional absolute path outside public web roots for private verification documents
# VERIFICATION_STORAGE_DIRECTORY=/private/campusbazaar/verification-documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend (frontend/.env)
VITE_API_BASE_URL=/api
